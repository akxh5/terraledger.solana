# TerraLedger Environment Configuration Example
# Copy this file to .env.local and fill in the values

# Solana Network Cluster (devnet, testnet, or mainnet-beta)
VITE_CLUSTER=devnet

# Solana RPC Endpoint
VITE_RPC_ENDPOINT=https://api.devnet.solana.com

# TerraLedger Program ID (deployed on devnet)
VITE_PROGRAM_ID=FXfyLUSeLn8pZrUTPjN7iGqjqRBwLRiHz2XKhnoDriQM

# Feature Flags
VITE_DEMO_MODE=true

# Helius RPC API Key (Optional, helps avoid 429 rate limiting)
VITE_HELIUS_API_KEY=your_helius_key_here

# Pinata IPFS Credentials (SERVER-SIDE ONLY)
# Never prefix with VITE_ to avoid exposing in client bundle
PINATA_JWT=your_pinata_jwt_here
