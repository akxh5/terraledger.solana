# TerraLedger Environment Configuration Example
# Copy this file to .env.local and fill in the values

# Solana Network Cluster (devnet, testnet, or mainnet-beta)
VITE_CLUSTER=devnet

# Solana RPC Endpoint
VITE_RPC_ENDPOINT=https://api.devnet.solana.com

# TerraLedger Program ID (deployed on devnet)
VITE_PROGRAM_ID=FXfyLUSeLn8pZrUTPjN7iGqjqRBwLRiHz2XKhnoDriQM

# Feature Flags
VITE_DEMO_MODE=true

# Pinata IPFS Credentials (Required for document uploads)
# Priority: JWT is used if present, otherwise API Key + Secret
VITE_PINATA_JWT=your_pinata_jwt_here
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET=your_pinata_secret_here
